{
  "name": "@edlsh/omp-cua",
  "version": "0.1.0",
  "description": "Native macOS desktop control for OMP agents, backed by the cua-driver CuaDriver.app daemon",
  "type": "module",
  "keywords": ["omp", "oh-my-pi", "extension", "macos", "desktop", "computer-use", "cua"],
  "author": "Enzo Lucchesi <enzo@edl.sh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edlsh/omp-cua.git"
  },
  "bugs": {
    "url": "https://github.com/edlsh/omp-cua/issues"
  },
  "homepage": "https://github.com/edlsh/omp-cua#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": "./src/index.ts",
  "files": ["src", "skills", "README.md", "LICENSE"],
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": ["darwin"],
  "dependencies": {
    "@trycua/cua-driver": "0.36.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.1.16 <19"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.12.2",
    "@types/bun": "1.4.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
