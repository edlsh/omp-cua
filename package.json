{
  "name": "@edlsh/omp-cua",
  "version": "0.4.0",
  "description": "Native macOS desktop control for OMP agents, backed by the cua-driver CuaDriver.app daemon",
  "type": "module",
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "omp-extension",
    "extension",
    "macos",
    "desktop",
    "desktop-automation",
    "computer-use",
    "cua",
    "cua-driver",
    "accessibility",
    "ai-agent"
  ],
  "author": "Enzo Lucchesi <enzo@edl.sh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edlsh/omp-cua.git"
  },
  "bugs": {
    "url": "https://github.com/edlsh/omp-cua/issues"
  },
  "homepage": "https://github.com/edlsh/omp-cua#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": "./src/index.ts",
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/extension.test.ts test/omp.test.ts",
    "test:live": "bun test test/live.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "check": "bun run typecheck && bun run test && bun run check:package"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@trycua/cua-driver": "0.64.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.1.16 <20"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "19.2.1",
    "@types/bun": "1.4.5",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
